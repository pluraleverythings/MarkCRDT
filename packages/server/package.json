{
  "name": "@markcrdt/server",
  "version": "0.1.0",
  "description": "Sync server for MarkCRDT (HTTP + WebSocket + Postgres).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "schema.sql"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@markcrdt/core": "0.1.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  }
}
